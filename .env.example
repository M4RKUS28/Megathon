# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=localhost
AUTH_DOMAIN=auth.localhost

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=uploads
MINIO_PRESIGNED_EXPIRY=3600
# Browser-reachable base for presigned URLs (nginx proxies /storage -> minio:9000)
MINIO_PUBLIC_URL=http://localhost/storage

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=app-frontend
KEYCLOAK_CLIENT_SECRET=changeme

# ── Backend ───────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost","http://localhost:5173"]

# ── Redis / Queue ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Devin API (course generation) — v3 org-scoped API ────────────────────────
# Service-user token from Devin (Settings > Service users). Starts with "cog_".
DEVIN_API_KEY=
# Your Devin organization id (Settings > Service users, or GET /v3/self -> org_id).
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3
# Optional snapshot/playbook to make generation deterministic & fast.
DEVIN_SNAPSHOT_ID=
DEVIN_PLAYBOOK_ID=
DEVIN_MAX_ACU_LIMIT=20

# ── Google Gemini (agentic planner / script-writer + media generation) ───────
# AI Studio key (https://aistudio.google.com/app/apikey). Also powers
# Nano-Banana image generation and Gemini TTS. Leave blank to use offline
# deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ── Cala MCP (company knowledge for the planner agent) ───────────────────────
# Streamable-HTTP MCP endpoint + key. Blank -> placeholder knowledge tools.
CALA_API_KEY=
CALA_MCP_URL=

# ── PixVerse (image/video generation) ────────────────────────────────────────
PIXVERSE_API_KEY=
PIXVERSE_API_BASE_URL=https://app-api.pixverse.ai

# ── Asset pipeline + Devin code-gen ──────────────────────────────────────────
# auto = use the best configured provider per type, else branded SVG placeholder.
ASSET_IMAGE_PROVIDER=auto
ASSET_VIDEO_PROVIDER=auto
ASSET_AUDIO_PROVIDER=auto
# true = author each course's Vite app with a real Devin coding session.
COURSE_BUILD_USE_DEVIN=false

# ── Platform / Multi-tenant ──────────────────────────────────────────────────
DEMO_COMPANY_SLUG=acme
COURSES_BUCKET=courses
PLATFORM_PUBLIC_URL=http://localhost
