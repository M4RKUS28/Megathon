{
  "realm": "app",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user (employee / learner)" },
      { "name": "course_creator", "description": "Creates, manages and assigns courses (HR / dept lead)" },
      { "name": "admin", "description": "Administrator" }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "app-frontend",
      "name": "App Frontend (SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "app-frontend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "app-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "company-slug",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_slug",
            "claim.name": "company_slug",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@acme.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "creator",
      "enabled": true,
      "emailVerified": true,
      "email": "creator@acme.test",
      "firstName": "Carla",
      "lastName": "Creator",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "creator", "temporary": false }
      ],
      "realmRoles": ["user", "course_creator"]
    },
    {
      "username": "employee",
      "enabled": true,
      "emailVerified": true,
      "email": "employee@acme.test",
      "firstName": "Erik",
      "lastName": "Employee",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "employee", "temporary": false }
      ],
      "realmRoles": ["user"]
    }
  ]
}
