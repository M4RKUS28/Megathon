{
  "realm": "app",
  "enabled": true,
  "displayName": "Coursive",
  "loginTheme": "coursive",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(8) and maxLength(64)",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user (employee / learner)" },
      { "name": "course_creator", "description": "Creates, manages and assigns courses (HR / dept lead)" },
      { "name": "admin", "description": "Administrator" }
    ]
  },
  "defaultRoles": ["user", "course_creator"],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "app-frontend",
      "name": "App Frontend (SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:5173/*",
        "${PLATFORM_PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:5173/*##${PLATFORM_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "app-frontend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "app-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "company-slug",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "company_slug",
            "claim.name": "company_slug",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo@example.com",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "demo2026", "temporary": false }
      ],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "admin@acme.test",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@acme.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "admin2026", "temporary": false }
      ],
      "realmRoles": ["user", "admin"]
    },
    {
      "username": "creator@acme.test",
      "enabled": true,
      "emailVerified": true,
      "email": "creator@acme.test",
      "firstName": "Carla",
      "lastName": "Creator",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "creator2026", "temporary": false }
      ],
      "realmRoles": ["user", "course_creator"]
    },
    {
      "username": "employee@acme.test",
      "enabled": true,
      "emailVerified": true,
      "email": "employee@acme.test",
      "firstName": "Erik",
      "lastName": "Employee",
      "attributes": { "company_slug": ["acme"] },
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "employee2026", "temporary": false }
      ],
      "realmRoles": ["user"]
    }
  ]
}
