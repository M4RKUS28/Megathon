COMPOSE_PROJECT_NAME=megathon
BACKEND_IMAGE=docker.io/your-dockerhub-user/megathon-backend
FRONTEND_IMAGE=docker.io/your-dockerhub-user/megathon-frontend
IMAGE_TAG=latest

TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINTS=web
TRAEFIK_ROUTER_RULE=PathPrefix(`/`)
TRAEFIK_API_RULE=PathPrefix(`/api`)
TRAEFIK_AUTH_RULE=PathPrefix(`/auth`)
TRAEFIK_STORAGE_RULE=PathPrefix(`/storage`)
TRAEFIK_PRIORITY=1
TRAEFIK_SYSTEM_PRIORITY=100

PLATFORM_PUBLIC_URL=http://203.0.113.10

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=uploads
COURSES_BUCKET=courses
MINIO_PRESIGNED_EXPIRY=3600
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://203.0.113.10/storage

KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=app-frontend
KEYCLOAK_CLIENT_SECRET=change-me

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO
CORS_ORIGINS=["http://203.0.113.10"]

REDIS_URL=redis://redis:6379/0

DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3
DEVIN_SNAPSHOT_ID=
DEVIN_PLAYBOOK_ID=
DEVIN_MAX_ACU_LIMIT=20

DEMO_COMPANY_SLUG=acme
COURSE_TEMPLATE_DIST=/app/course_template_dist

VITE_API_URL=/api/v1
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=app
VITE_KEYCLOAK_CLIENT_ID=app-frontend
